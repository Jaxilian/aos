#!/bin/sh
#
# aos-install -- copy the running live system onto a disk and make it boot.
#
# The live root and the installed root are the same filesystem, so there is
# no separate image to unpack: this partitions the disk, copies the running
# root onto it, and installs a bootloader for both BIOS and UEFI.

set -e

usage() {
	cat <<USAGE
Usage: aos-install <disk>

  <disk>  the whole disk to install onto, e.g. /dev/sda or /dev/nvme0n1

This ERASES the target disk completely.
USAGE
	exit 1
}

[ $# -eq 1 ] || usage
DISK="$1"
[ -b "$DISK" ] || { echo "aos-install: $DISK is not a block device" >&2; exit 1; }

# Partition naming differs between /dev/sda2 and /dev/nvme0n1p2.
case "$DISK" in
	*[0-9]) PART_PREFIX="${DISK}p" ;;
	*)      PART_PREFIX="$DISK" ;;
esac
BIOSBOOT="${PART_PREFIX}1"
ESP="${PART_PREFIX}2"
ROOT="${PART_PREFIX}3"

# Booting both ways from one disk needs a GPT with a BIOS boot partition for
# GRUB's core image (there is no MBR gap to embed it in) alongside the ESP.
echo "This will ERASE all data on $DISK."
printf "Type YES to continue: "
read -r confirm
[ "$confirm" = "YES" ] || { echo "Aborted."; exit 1; }

echo ">>> Wiping old partition tables and signatures from $DISK"
# A disk that has been a live ISO, an installed system, or anything else
# carries more than one description of itself: an MBR with boot code, a
# GPT, sometimes an Apple map or hybrid entries, plus a backup GPT at the
# far end. parted's mklabel rewrites only the table it owns, and GRUB's
# BIOS installer refuses a disk on which it can still see a second
# partition map ("multiple partition labels"). So scrub first: every known
# signature, then the first and last 2 MiB outright, which is where all of
# those structures live.
wipefs -a "$DISK" >/dev/null
# In 512-byte sectors, not MiB: the backup GPT header sits in the very last
# sector, and a size that is not a whole number of MiB would leave it.
DISK_SECTORS=$(blockdev --getsz "$DISK")
dd if=/dev/zero of="$DISK" bs=512 count=4096 status=none
dd if=/dev/zero of="$DISK" bs=512 count=4096 seek=$(( DISK_SECTORS - 4096 )) status=none
sync

echo ">>> Partitioning $DISK"
# Three partitions, because booting the same disk on both firmwares needs
# two different things from it:
#
#   1. a BIOS boot partition -- on GPT there is no post-MBR gap to embed
#      GRUB's core image in, and without somewhere to put it grub-install
#      refuses with "will not proceed with blocklists";
#   2. an EFI system partition for the UEFI bootloader;
#   3. the root filesystem.
parted -s "$DISK" mklabel gpt
parted -s "$DISK" mkpart bios_grub 1MiB 2MiB
parted -s "$DISK" set 1 bios_grub on
parted -s "$DISK" mkpart ESP fat32 2MiB 514MiB
parted -s "$DISK" set 2 esp on
parted -s "$DISK" mkpart root ext4 514MiB 100%

# Give the kernel a moment to notice the new partition table.
partprobe "$DISK" 2>/dev/null || true
udevadm settle 2>/dev/null || true

echo ">>> Creating filesystems"
mkfs.fat -F32 -n AOS_ESP "$ESP"
mkfs.ext4 -F -L aos "$ROOT"

echo ">>> Mounting"
# Under /run, not /mnt: on the live ISO the root filesystem is read-only and
# a mount point cannot be created anywhere on it.
TARGET=/run/aos-install
mkdir -p "$TARGET"
mount "$ROOT" "$TARGET"
mkdir -p "$TARGET/boot/efi"
mount "$ESP" "$TARGET/boot/efi"

echo ">>> Copying system (this takes a while)"
# Copy through a bind mount of / rather than from / directly.
#
# A bind mount exposes the root filesystem as it actually is, with nothing
# mounted over it. Copying from / instead would pick up the runtime tmpfs on
# /var -- and so install an empty /var, because the real one underneath is
# hidden -- as well as having to exclude /proc, /sys, /dev and /run by hand.
SRC=/run/aos-src
mkdir -p "$SRC"
mount --bind / "$SRC"
tar -cf - -C "$SRC" . | tar -xf - -C "$TARGET"
umount "$SRC"
rmdir "$SRC"

# Mount points, which are empty directories in the source tree.
mkdir -p "$TARGET/proc" "$TARGET/sys" "$TARGET/dev" "$TARGET/run" "$TARGET/tmp"
chmod 1777 "$TARGET/tmp"

# /var. On the live ISO it is a tmpfs seeded from /usr/share/factory/var
# (Buildroot's arrangement for a read-only root), and the /var underneath --
# the one the bind-mount copy just installed -- is an empty directory. Fill
# it from the factory so the installed system starts with a real /var. The
# var.mount drop-in in /etc/systemd/system keeps the tmpfs off once the root
# is writable.
cp -a /usr/share/factory/var/. "$TARGET/var/"
# journald keeps logs across reboots only if this directory exists. On the
# ISO the journal is volatile because /var is.
mkdir -p "$TARGET/var/log/journal"

echo ">>> Creating swap file"
# zram (set up by zram-setup.service) is the first swap device everywhere;
# this file is the second, at a lower priority, and is what gives an
# installed machine real headroom when a big build outgrows RAM.
#
# Size: the machine's RAM, at most 8 GiB, and never so much that less than
# 4 GiB of the root filesystem is left free. There is no hibernation to size
# for. Written with dd, NOT fallocate: fallocate leaves unwritten extents
# and swapon then refuses the file with "it appears to have holes".
mem_mb=$(( $(awk '/^MemTotal:/ { print $2 }' /proc/meminfo) / 1024 ))
swap_mb=$mem_mb
[ "$swap_mb" -gt 8192 ] && swap_mb=8192
avail_mb=$(df -m --output=avail "$TARGET" | tail -1)
max_by_disk=$(( avail_mb - 4096 ))
[ "$swap_mb" -gt "$max_by_disk" ] && swap_mb=$max_by_disk
if [ "$swap_mb" -ge 512 ]; then
	dd if=/dev/zero of="$TARGET/swapfile" bs=1M count="$swap_mb" status=none
	chmod 600 "$TARGET/swapfile"
	mkswap -q "$TARGET/swapfile"
	SWAP_LINE="/swapfile			none		swap	defaults,pri=10		0	0"
	echo "    ${swap_mb} MiB at /swapfile"
else
	SWAP_LINE="# no swap file: the root filesystem is too small for one (see aos-install)"
	echo "    skipped: not enough space on the root filesystem"
fi

echo ">>> Writing /etc/fstab"
ROOT_UUID=$(blkid -s UUID -o value "$ROOT")
ESP_UUID=$(blkid -s UUID -o value "$ESP")
# The kernel command line needs the *partition* UUID, not the filesystem one.
# AOS boots without an initramfs, and resolving root=UUID= means reading
# filesystem superblocks -- which is userspace's job, normally done inside an
# initrd. PARTUUID comes from the GPT itself, so the kernel can resolve it on
# its own. Using UUID= here panics with "Unable to mount root fs".
ROOT_PARTUUID=$(blkid -s PARTUUID -o value "$ROOT")
# Why this fstab looks the way it does.
#
#  - "/" is listed, with fsck pass 1. The kernel mounts the root read-only
#    from root=PARTUUID= (it cannot resolve UUID= without an initramfs);
#    systemd-fsck-root then checks it -- which is only possible while it is
#    still read-only -- and systemd-remount-fs makes it writable using this
#    line. Without the line the root would never be checked, and after an
#    unclean shutdown errors would accumulate silently behind journal replay.
#  - /boot/efi is by UUID. systemd turns the line into a mount unit that
#    waits for udev to create /dev/disk/by-uuid/... before mounting, so
#    there is no "mount before udev" problem to work around. nofail makes a
#    missing or damaged ESP degrade the boot rather than stop it.
#  - /proc, /sys, /dev and /run are mounted by systemd itself; listing them
#    here would only duplicate that.
#  - The swap file is pri=10, behind zram at pri=100.
cat > "$TARGET/etc/fstab" <<FSTAB
# <device>			<mount>		<type>	<options>			<dump>	<pass>
# The kernel mounts / read-only from root=PARTUUID= in /boot/grub/grub.cfg;
# this line is what gets it checked and then remounted read-write.
UUID=$ROOT_UUID		/		ext4	defaults		0	1
UUID=$ESP_UUID		/boot/efi	vfat	defaults,noatime,nofail		0	2
tmpfs				/tmp		tmpfs	defaults		0	0
$SWAP_LINE
FSTAB

echo ">>> Installing bootloader"
for d in proc sys dev; do mount --bind "/$d" "$TARGET/$d"; done

# UEFI. --removable writes EFI/BOOT/BOOTX64.EFI, which firmware will boot
# without needing an NVRAM entry -- important for a disk that may be moved
# between machines, and for firmware that forgets its boot entries.
chroot "$TARGET" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
	--bootloader-id=AOS --removable --recheck || \
	echo "!! UEFI bootloader install failed (not an EFI system?)"

# BIOS. Harmless on a UEFI-only machine, and makes the same disk boot on
# older hardware.
chroot "$TARGET" grub-install --target=i386-pc --recheck "$DISK" || \
	echo "!! BIOS bootloader install failed (no i386-pc GRUB target?)"

# Write grub.cfg directly rather than running grub-mkconfig.
#
# grub-mkconfig's 10_linux script discovers kernels by filename, looking for
# vmlinuz-* or kernel-*. AOS installs its kernel as /boot/bzImage, so
# grub-mkconfig finds nothing, emits a menu with no Linux entry at all, and
# still exits successfully -- the machine then boots to firmware settings.
# A foundation image has exactly one kernel and no /etc/default/grub
# machinery, so writing the file out is both simpler and predictable.
echo ">>> Writing grub.cfg"
mkdir -p "$TARGET/boot/grub"
cat > "$TARGET/boot/grub/grub.cfg" <<GRUBCFG
serial --unit=0 --speed=115200
terminal_input console serial
terminal_output console serial

set default="0"
set timeout="5"

# "ro": the root is checked by systemd-fsck-root before systemd-remount-fs
# makes it writable from /etc/fstab. The initrd is CPU microcode only.
# rootwait: harmless on an internal disk, and required when the system was
# installed onto a USB stick, whose enumeration finishes long after the
# kernel first looks for the root device.
#
# loglevel=4 on the entries that own the screen: kernel messages of warning
# severity and below go to the journal only, errors and worse still reach
# the screen. Without it every correctable PCIe error and driver notice
# scrolls over the console. The serial entry keeps the default 7 -- serial
# is the channel you watch a boot on.
menuentry "AOS" {
	linux /boot/bzImage root=PARTUUID=$ROOT_PARTUUID ro rootwait loglevel=4 console=ttyS0,115200 console=tty1
	initrd /boot/microcode.img
}

menuentry "AOS (serial console)" {
	linux /boot/bzImage root=PARTUUID=$ROOT_PARTUUID ro rootwait console=ttyS0,115200
	initrd /boot/microcode.img
}

# nomodeset keeps every DRM driver off the display, so the console stays on
# the firmware framebuffer no matter what the GPU driver does. This is the
# way back in when a graphics driver fails: log in, read journalctl -b -1,
# fix, reboot normally.
menuentry "AOS (safe graphics, no GPU driver)" {
	linux /boot/bzImage root=PARTUUID=$ROOT_PARTUUID ro rootwait nomodeset loglevel=4 console=ttyS0,115200 console=tty1
	initrd /boot/microcode.img
}
GRUBCFG

echo ">>> Unmounting"
for d in dev sys proc; do umount "$TARGET/$d"; done
umount "$TARGET/boot/efi"
umount "$TARGET"

echo
echo "AOS installed on $DISK. Remove the install media and reboot."
