#!/bin/sh
#
# aos-install -- copy the running live system onto a disk and make it boot.
#
# The live root and the installed root are the same filesystem, so there is
# no separate image to unpack: this partitions the disk, copies the running
# root onto it, and installs a bootloader for both BIOS and UEFI.

set -e

usage() {
	cat <<USAGE
Usage: aos-install [--demo | --user NAME [--hash HASH | --password-file FILE]]
                   [--keymap CODE] [--zone AREA/CITY] <disk>

  <disk>  the whole disk to install onto, e.g. /dev/sda or /dev/nvme0n1

  With no option, asks for a user name and a password: that account owns
  the desktop session and is a member of wheel, the live account (admin,
  no password, sudo without one) is not installed, and root's console
  login is locked.
  Root stays reachable over SSH with a key, and everything else through
  sudo.

  --user NAME --hash HASH   the same, unattended: NAME with HASH as its
                            crypt(3) password. (--release is accepted and
                            means nothing: it is the default now.)
  --password-file FILE      instead of --hash: the password, one line, in a
                            file (what the graphical installer writes).
  --keymap CODE             the keyboard layout (an XKB code, "se"), for the
                            desktop and the console of the installed system
  --zone AREA/CITY          its time zone ("Europe/Stockholm")
  --demo                    keep the demo account. For a test machine.

This ERASES the target disk completely.
USAGE
	exit 1
}

DEMO=no
NEWUSER=""
NEWHASH=""
NEWPASS=""
KEYMAP=""
ZONE=""
while [ $# -gt 1 ]; do
	case "$1" in
		--release) ;;
		--demo)    DEMO=yes ;;
		--user)    NEWUSER="$2"; shift ;;
		--hash)    NEWHASH="$2"; shift ;;
		--password-file) NEWPASS=$(head -n 1 "$2") || exit 1; shift ;;
		--keymap)  KEYMAP="$2"; shift ;;
		--zone)    ZONE="$2"; shift ;;
		*)         usage ;;
	esac
	shift
done
if [ -n "$KEYMAP" ]; then
	echo "$KEYMAP" | grep -qE '^[a-z]{2,8}$' || { echo "aos-install: '$KEYMAP' is not a keyboard layout code" >&2; exit 1; }
fi
if [ -n "$ZONE" ]; then
	case "$ZONE" in *..*) usage ;; esac
	[ -f "/usr/share/zoneinfo/$ZONE" ] || { echo "aos-install: no time zone '$ZONE'" >&2; exit 1; }
fi
[ $# -eq 1 ] || usage
DISK="$1"
[ -b "$DISK" ] || { echo "aos-install: $DISK is not a block device" >&2; exit 1; }

# The account. Asked for up front, before anything is erased, so a typo
# costs nothing. The password is hashed by chpasswd inside the installed
# tree later; the image has no openssl or mkpasswd to do it here.
if [ "$DEMO" = no ] && [ -z "$NEWUSER" ]; then
	[ -t 0 ] || { echo "aos-install: no terminal to ask for an account; pass --user and --hash, or --demo" >&2; exit 1; }
	echo "The account that owns this machine (lowercase letters, digits, - and _):"
	printf "User name: "
	read -r NEWUSER
	stty -echo
	printf "Password: "; read -r NEWPASS; echo
	printf "Again:    "; read -r PW2; echo
	stty echo
	[ "$NEWPASS" = "$PW2" ] || { echo "aos-install: passwords differ" >&2; exit 1; }
	[ -n "$NEWPASS" ] || { echo "aos-install: empty password" >&2; exit 1; }
fi
if [ "$DEMO" = no ]; then
	[ -n "$NEWUSER" ] || { echo "aos-install: --user needs a name" >&2; exit 1; }
	[ -n "$NEWHASH" ] || [ -n "$NEWPASS" ] || {
		echo "aos-install: --user needs --hash when there is no terminal" >&2; exit 1; }
	echo "$NEWUSER" | grep -qE '^[a-z_][a-z0-9_-]{0,31}$' || {
		echo "aos-install: '$NEWUSER' is not a usable user name" >&2; exit 1; }
	[ "$NEWUSER" != root ] || { echo "aos-install: the account cannot be root" >&2; exit 1; }
	[ "$NEWUSER" != admin ] || { echo "aos-install: admin is the demo account's name; pick another" >&2; exit 1; }
fi

. /usr/lib/aos/slot.sh

# Partition naming differs between /dev/sda2 and /dev/nvme0n1p2.
BIOSBOOT=$(slot_part "$DISK" 1)
ESP=$(slot_part "$DISK" 2)
SLOT_A=$(slot_part "$DISK" 3)
SLOT_B=$(slot_part "$DISK" 4)
DATA=$(slot_part "$DISK" 5)

# Two root slots of this many MiB each; an update writes the idle one. The
# image is about 3 GB and nothing else lands on a slot: programs, accounts
# and settings live on the data partition, which gets the rest of the disk.
SLOT_MIB=6144
# bios_grub + ESP + two slots + at least this much data.
MIN_DATA_MIB=2048
disk_mib=$(( $(blockdev --getsize64 "$DISK") / 1048576 ))
need_mib=$(( 514 + 2 * SLOT_MIB + MIN_DATA_MIB ))
[ "$disk_mib" -ge "$need_mib" ] || {
	echo "aos-install: $DISK is ${disk_mib} MiB; AOS needs at least ${need_mib} MiB" >&2; exit 1; }

# Booting both ways from one disk needs a GPT with a BIOS boot partition for
# GRUB's core image (there is no MBR gap to embed it in) alongside the ESP.
echo "This will ERASE all data on $DISK."
printf "Type YES to continue: "
read -r confirm
[ "$confirm" = "YES" ] || { echo "Aborted."; exit 1; }

echo ">>> Wiping old partition tables and signatures from $DISK"
# A disk that has been a live ISO, an installed system, or anything else
# carries more than one description of itself: an MBR with boot code, a
# GPT, sometimes an Apple map or hybrid entries, plus a backup GPT at the
# far end. parted's mklabel rewrites only the table it owns, and GRUB's
# BIOS installer refuses a disk on which it can still see a second
# partition map ("multiple partition labels"). So scrub first: every known
# signature, then the first and last 2 MiB outright, which is where all of
# those structures live.
wipefs -a "$DISK" >/dev/null
# In 512-byte sectors, not MiB: the backup GPT header sits in the very last
# sector, and a size that is not a whole number of MiB would leave it.
DISK_SECTORS=$(blockdev --getsz "$DISK")
dd if=/dev/zero of="$DISK" bs=512 count=4096 status=none
dd if=/dev/zero of="$DISK" bs=512 count=4096 seek=$(( DISK_SECTORS - 4096 )) status=none
sync

echo ">>> Partitioning $DISK"
# Five partitions (/usr/lib/aos/slot.sh describes the layout):
#
#   1. a BIOS boot partition -- on GPT there is no post-MBR gap to embed
#      GRUB's core image in, and without somewhere to put it grub-install
#      refuses with "will not proceed with blocklists";
#   2. an EFI system partition for the UEFI bootloader, GRUB's menu and
#      its grubenv, which choose between the slots;
#   3. root slot a, which this install fills;
#   4. root slot b, empty until the first update;
#   5. the data partition: /var, and through it /home, the apm store, the
#      user's half of /etc and the swap file.
a_end=$(( 514 + SLOT_MIB ))
b_end=$(( a_end + SLOT_MIB ))
parted -s "$DISK" mklabel gpt
parted -s "$DISK" mkpart bios_grub 1MiB 2MiB
parted -s "$DISK" set 1 bios_grub on
parted -s "$DISK" mkpart ESP fat32 2MiB 514MiB
parted -s "$DISK" set 2 esp on
parted -s "$DISK" mkpart aos-a ext4 514MiB ${a_end}MiB
parted -s "$DISK" mkpart aos-b ext4 ${a_end}MiB ${b_end}MiB
parted -s "$DISK" mkpart aos-data ext4 ${b_end}MiB 100%

# Give the kernel a moment to notice the new partition table.
partprobe "$DISK" 2>/dev/null || true
udevadm settle 2>/dev/null || true

echo ">>> Creating filesystems"
mkfs.fat -F32 -n AOS_ESP "$ESP"
mkfs.ext4 -q -F -L aos-a "$SLOT_A"
mkfs.ext4 -q -F -L aos-b "$SLOT_B"
mkfs.ext4 -q -F -L aos-data "$DATA"

echo ">>> Mounting"
# Under /run, not /mnt: on the live ISO the root filesystem is read-only and
# a mount point cannot be created anywhere on it.
TARGET=/run/aos-install
mkdir -p "$TARGET"
mount "$SLOT_A" "$TARGET"
mkdir -p "$TARGET/boot/efi" "$TARGET/var"
mount "$ESP" "$TARGET/boot/efi"
mount "$DATA" "$TARGET/var"

echo ">>> Copying system (this takes a while)"
# Copy through a bind mount of / rather than from / directly.
#
# A bind mount exposes the root filesystem as it actually is, with nothing
# mounted over it. Copying from / instead would pick up the runtime tmpfs on
# /var -- and so install an empty /var, because the real one underneath is
# hidden -- as well as having to exclude /proc, /sys, /dev and /run by hand.
SRC=/run/aos-src
mkdir -p "$SRC"
mount --bind / "$SRC"
tar -cf - -C "$SRC" . | tar -xf - -C "$TARGET"
umount "$SRC"
# The mark of a completely written slot, which aos-update --rollback asks
# for before it will boot one.
: > "$TARGET/.aos-slot-ok"
rmdir "$SRC"

# Mount points, which are empty directories in the source tree.
mkdir -p "$TARGET/proc" "$TARGET/sys" "$TARGET/dev" "$TARGET/run" "$TARGET/tmp"
chmod 1777 "$TARGET/tmp"
# GRUB's files go on the ESP; the image's /boot/grub is Buildroot's stub.
rm -rf "$TARGET/boot/grub"

# The data partition. The copy wrote the image's /var -- an empty directory
# on the live ISO, where /var is a tmpfs seeded from /usr/share/factory/var
# -- straight onto it, since it was mounted there; fill it from the factory
# so the installed system starts with a real /var. journald keeps logs
# across reboots only if its directory exists. Then what the image carries
# in /home and /opt/apm moves here, under the bind mounts they become.
cp -a /usr/share/factory/var/. "$TARGET/var/"
slot_data_dirs "$TARGET/var"
cp -a "$TARGET/home/." "$TARGET/var/home/"
cp -a "$TARGET/opt/apm/." "$TARGET/var/apm/"
rm -rf "$TARGET/home" "$TARGET/opt/apm"
mkdir -p "$TARGET/home" "$TARGET/opt/apm"

echo ">>> Creating swap file"
# zram (set up by zram-setup.service) is the first swap device everywhere;
# this file is the second, at a lower priority, and is what gives an
# installed machine real headroom when a big build outgrows RAM.
#
# Size: the machine's RAM, at most 8 GiB, and never so much that less than
# 4 GiB of the data partition is left free. There is no hibernation to size
# for. Written with dd, NOT fallocate: fallocate leaves unwritten extents
# and swapon then refuses the file with "it appears to have holes".
mem_mb=$(( $(awk '/^MemTotal:/ { print $2 }' /proc/meminfo) / 1024 ))
swap_mb=$mem_mb
[ "$swap_mb" -gt 8192 ] && swap_mb=8192
avail_mb=$(df -m --output=avail "$TARGET/var" | tail -1)
max_by_disk=$(( avail_mb - 4096 ))
[ "$swap_mb" -gt "$max_by_disk" ] && swap_mb=$max_by_disk
if [ "$swap_mb" -ge 512 ]; then
	dd if=/dev/zero of="$TARGET/var/swapfile" bs=1M count="$swap_mb" status=none
	chmod 600 "$TARGET/var/swapfile"
	mkswap -q "$TARGET/var/swapfile"
	SWAP_LINE="/var/swapfile			none		swap		defaults,pri=10			0	0"
	echo "    ${swap_mb} MiB at /var/swapfile"
else
	SWAP_LINE="# no swap file: the data partition is too small for one (see aos-install)"
	echo "    skipped: not enough space on the data partition"
fi

echo ">>> Writing /etc/fstab"
# Into the slot's own /etc, before the overlay goes over it: this is the
# one file read from there, by /usr/lib/aos/init, to find the data
# partition.
slot_write_fstab "$TARGET/etc" \
	"UUID=$(blkid -s UUID -o value "$SLOT_A")" \
	"UUID=$(blkid -s UUID -o value "$DATA")" \
	"UUID=$(blkid -s UUID -o value "$ESP")" \
	"$SWAP_LINE"

# From here on the target looks the way it will run: /etc is the overlay,
# so the account, the machine id and the session drop-in land on the data
# partition and belong to both slots.
slot_mount_tree "$TARGET"
for d in proc sys dev; do mount --bind "/$d" "$TARGET/$d"; done
systemd-machine-id-setup --root="$TARGET" >/dev/null 2>&1

# Accounts, inside the installed tree so its own passwd, shadow and home
# are what change -- the live system running this stays as it was.
if [ "$DEMO" = no ]; then
	echo ">>> Account: $NEWUSER replaces the demo account; root's console login is locked"
	chroot "$TARGET" userdel -r admin 2>/dev/null || true
	# The live system's leave: passwordless sudo for that account, and
	# the marker that turns the lock screen off.
	rm -f "$TARGET/etc/sudoers.d/20-aos-live" "$TARGET/etc/aos/live"
	# wheel for sudo and polkit; pipewire for real-time audio (its limits.d
	# entry, through pam_limits); video for the backlight (the udev rule in
	# 70-aos-backlight.rules) -- the same three the demo account has.
	chroot "$TARGET" useradd -m -G wheel,pipewire,video -s /bin/bash "$NEWUSER"
	if [ -n "$NEWHASH" ]; then
		chroot "$TARGET" usermod -p "$NEWHASH" "$NEWUSER"
	else
		printf '%s:%s\n' "$NEWUSER" "$NEWPASS" | chroot "$TARGET" chpasswd
	fi
	# A locked password refuses the console and nothing else: sshd's key
	# login for root goes through pam account, which a lock does not touch.
	chroot "$TARGET" passwd -l root >/dev/null
	cat > "$TARGET/etc/systemd/system/ade.service.d/10-aos-user.conf" <<USERCONF
# Written by aos-install: the desktop session is this account's.
[Service]
User=$NEWUSER
USERCONF
fi

# The keyboard layout and the time zone, through the overlay so they
# belong to both slots. The desktop reads its layout from
# /etc/ade/environment, the console from vconsole.conf (the same table the
# Settings application uses for the console name; a layout without a
# console map of its own keeps the default), the zone from /etc/localtime.
if [ -n "$KEYMAP" ]; then
	echo ">>> Keyboard: $KEYMAP"
	env="$TARGET/etc/ade/environment"
	grep -v '^XKB_DEFAULT_LAYOUT=' "$env" > "$env.new" 2>/dev/null || true
	echo "XKB_DEFAULT_LAYOUT=$KEYMAP" >> "$env.new"
	mv "$env.new" "$env"
	console=$KEYMAP
	case "$KEYMAP" in
		se) console=sv-latin1 ;; de) console=de-latin1 ;; fr) console=fr-latin1 ;;
		es) console=es ;; it) console=it ;; no) console=no-latin1 ;; dk) console=dk-latin1 ;;
		fi) console=fi ;; gb) console=uk ;; us) console=us ;; pl) console=pl ;; ru) console=ru ;;
		ch) console=de_CH-latin1 ;; pt) console=pt-latin1 ;; nl) console=nl ;; cz) console=cz-lat2 ;;
	esac
	if ls /usr/share/keymaps/i386/*/"$console".map.gz >/dev/null 2>&1; then
		grep -v '^KEYMAP=' "$TARGET/etc/vconsole.conf" > "$TARGET/etc/vconsole.conf.new" 2>/dev/null || true
		echo "KEYMAP=$console" >> "$TARGET/etc/vconsole.conf.new"
		mv "$TARGET/etc/vconsole.conf.new" "$TARGET/etc/vconsole.conf"
	fi
fi
if [ -n "$ZONE" ]; then
	echo ">>> Time zone: $ZONE"
	ln -sfn "../usr/share/zoneinfo/$ZONE" "$TARGET/etc/localtime"
fi

echo ">>> Installing bootloader"
# GRUB's directory (modules, grub.cfg, grubenv) is on the ESP for both
# firmwares -- --boot-directory -- since it has to outlive either slot.
#
# UEFI. --removable writes EFI/BOOT/BOOTX64.EFI, which firmware will boot
# without needing an NVRAM entry -- important for a disk that may be moved
# between machines, and for firmware that forgets its boot entries.
chroot "$TARGET" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
	--boot-directory=/boot/efi --bootloader-id=AOS --removable --recheck || \
	echo "!! UEFI bootloader install failed (not an EFI system?)"

# BIOS. Harmless on a UEFI-only machine, and makes the same disk boot on
# older hardware.
chroot "$TARGET" grub-install --target=i386-pc --boot-directory=/boot/efi \
	--recheck "$DISK" || \
	echo "!! BIOS bootloader install failed (no i386-pc GRUB target?)"

# Write grub.cfg directly rather than running grub-mkconfig.
#
# grub-mkconfig's 10_linux script discovers kernels by filename, looking for
# vmlinuz-* or kernel-*. AOS installs its kernel as /boot/bzImage, so
# grub-mkconfig finds nothing, emits a menu with no Linux entry at all, and
# still exits successfully -- the machine then boots to firmware settings.
# The menu knows both slots; grubenv says which one boots.
echo ">>> Writing grub.cfg"
slot_write_grub_cfg "$TARGET/boot/efi/grub/grub.cfg" \
	"$(blkid -s PARTUUID -o value "$SLOT_A")" \
	"$(blkid -s PARTUUID -o value "$SLOT_B")"
grub-editenv "$TARGET/boot/efi/grub/grubenv" create
grub-editenv "$TARGET/boot/efi/grub/grubenv" set slot=a

echo ">>> Unmounting"
for d in dev sys proc; do umount "$TARGET/$d"; done
slot_umount_tree "$TARGET"
umount "$TARGET/var"
umount "$TARGET/boot/efi"
umount "$TARGET"

echo
echo "AOS installed on $DISK. Remove the install media and reboot."
