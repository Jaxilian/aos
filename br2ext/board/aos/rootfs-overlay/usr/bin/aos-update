#!/bin/sh
#
# aos-update -- move this machine to a newer AOS release.
#
# The disk has two root slots (see /usr/lib/aos/slot.sh). A release is a
# tarball of the root filesystem, named with its sha256 in a SHA256SUMS
# file that is signed with the key every AOS machine trusts for apm. This
# fetches and checks those, writes the release into the idle slot, and
# tells GRUB to boot that slot once. Reaching the desktop confirms it; a
# boot that does not come up falls back to the old slot at the next reset.
# Nothing on the data partition -- accounts, /home, installed programs,
# settings -- is touched.

set -e
. /usr/lib/aos/slot.sh

usage() {
	cat <<USAGE
Usage: aos-update [--url URL]        fetch the newest release into the idle slot
       aos-update --check [--url URL] say whether there is a newer release
       aos-update --progress          with the fetch: "::os VER downloading 40",
                                      "::os VER installing", "::os VER done" lines
                                      for a program driving it (apm --progress)
       aos-update --rollback          boot the other slot at the next restart
       aos-update --confirm           make the running slot the default (a service runs this)
USAGE
	exit 1
}

URL=$(sed -n 's/^URL=//p' /usr/lib/aos/update.conf)
MODE=install
PROG=no
while [ $# -gt 0 ]; do
	case "$1" in
		--check)    MODE=check ;;
		--progress) PROG=yes ;;
		--confirm)  MODE=confirm ;;
		--rollback) MODE=rollback ;;
		--url)      URL="$2"; shift ;;
		*)          usage ;;
	esac
	shift
done
[ "$(id -u)" = 0 ] || { echo "aos-update: needs root" >&2; exit 1; }
CUR=$(slot_current) || { echo "aos-update: this system did not boot from a root slot" >&2; exit 1; }

# One at a time. Settings' Install pressed twice and then Upgrade (which
# runs this too) had three of these formatting and writing the same slot
# at once (the G14, 2026-10-02); the second and third now say so and
# leave. --check and --confirm are reads and take no lock.
LOCK=/run/aos-update.lock
case "$MODE" in
install|rollback)
	exec 9> "$LOCK"
	flock -n 9 || { echo "aos-update: another update is already running" >&2; exit 1; }
	;;
esac
# What this printed, kept: Settings shows the tail of it and nothing else
# keeps it, so a failed update had left no trace to read afterwards.
if [ "$MODE" = install ]; then
	LOG=/var/log/aos-update.log
	{ echo; echo "=== $(date '+%F %T') aos-update"; } >> "$LOG" 2>/dev/null || LOG=/dev/null
	# tee -p: Settings closed mid-update takes the pipe with it, and
	# without -p tee dies of the broken pipe and the next echo kills this
	# script under set -e, mid-write. With it tee keeps the file going.
	exec > >(tee -p -a "$LOG") 2>&1
fi

grubenv_get() {
	grub-editenv "$GRUBENV" list | sed -n "s/^$1=//p"
}

case "$MODE" in
confirm)
	[ -f "$GRUBENV" ] || exit 0
	if [ "$(grubenv_get slot)" != "$CUR" ]; then
		grub-editenv "$GRUBENV" set "slot=$CUR"
		echo "aos-update: slot $CUR confirmed"
	fi
	exit 0
	;;
rollback)
	# A slot is complete when its verity parameters are on the ESP: that
	# file is the last thing a write puts there.
	OTHER=$(slot_other)
	[ -f "$ESPAOS/$OTHER/verity.cfg" ] || { echo "aos-update: slot $OTHER holds no system" >&2; exit 1; }
	ver=$(sed -n 's/^PRETTY_NAME="\(.*\)"/\1/p' "$ESPAOS/$OTHER/os-release")
	grub-editenv "$GRUBENV" set "next=$OTHER"
	echo "$ver (slot $OTHER) boots at the next restart"
	exit 0
	;;
esac

# check and install: what is out there, against what this is.
CUR_VER=$(sed -n 's/^VERSION_ID=//p' /etc/os-release)
# Under /var, not /tmp: the tarball is big and /tmp is memory.
WORK=/var/tmp/aos-update
rm -rf "$WORK"
mkdir -p "$WORK"
trap 'rm -rf "$WORK"' EXIT

curl -fsSL -o "$WORK/SHA256SUMS" "$URL/SHA256SUMS"
curl -fsSL -o "$WORK/SHA256SUMS.minisig" "$URL/SHA256SUMS.minisig"
# Any trusted key will do; `apm verify` alone checks against the user's
# own signing key, which a machine does not have.
ok=no
for k in /opt/apm/etc/keys/trusted/*.pub; do
	[ -f "$k" ] || continue
	if apm verify "$WORK/SHA256SUMS" --key "$k" > /dev/null 2>&1; then ok=yes; break; fi
done
[ "$ok" = yes ] || { echo "aos-update: SHA256SUMS from $URL is not signed by a trusted key" >&2; exit 1; }

# The release: the core image (a squashfs, compressed as it is) and its
# verity parameters (docs/layout.md).
TAR=$(awk '$2 ~ /^aos-.*-x86_64-core\.img$/ { print $2; exit }' "$WORK/SHA256SUMS")
[ -n "$TAR" ] || { echo "aos-update: no core image in $URL/SHA256SUMS" >&2; exit 1; }
NEW_VER=${TAR#aos-}
NEW_VER=${NEW_VER%-x86_64-core.img}
VERITY="aos-$NEW_VER-x86_64-core.verity"
if [ "$(printf '%s\n%s\n' "$CUR_VER" "$NEW_VER" | sort -V | tail -1)" = "$CUR_VER" ]; then
	echo "AOS $CUR_VER is the newest release; nothing to do"
	exit 0
fi
OTHER=$(slot_other)
DEV=$(slot_dev "$OTHER")
# The release already written and waiting for the restart: Upgrade system
# pressed again, or the check run before the reboot, must not write the
# slot a second time or call the update outstanding. The ESP's copy of
# the slot's os-release says what is there (slot.sh).
# The lines the Software application reads for its Update page; a person
# at a terminal sees the >>> lines alone.
prog() {
	if [ "$PROG" = yes ]; then echo "::os $NEW_VER $*"; fi
}
if [ "$(slot_version "$OTHER")" = "$NEW_VER" ] && [ "$(grubenv_get next)" = "$OTHER" ]; then
	echo "AOS $NEW_VER is already in slot $OTHER and boots at the next restart"
	prog done
	exit 0
fi
if [ "$MODE" = check ]; then
	echo "AOS $NEW_VER is available (this is $CUR_VER)"
	exit 0
fi

echo ">>> Downloading AOS $NEW_VER"
prog downloading 0
if [ "$PROG" = yes ]; then
	# The percentage is the file growing against the size the server
	# states; curl is silent, so it is measured from outside.
	size=$(curl -fsSLI "$URL/$TAR" | tr -d '\r' | awk 'tolower($1) == "content-length:" { n = $2 } END { print n }')
	curl -fsSL -o "$WORK/$TAR" "$URL/$TAR" &
	pid=$!
	while kill -0 "$pid" 2>/dev/null; do
		if [ -n "$size" ] && [ "$size" -gt 0 ] && [ -f "$WORK/$TAR" ]; then
			prog downloading $(( $(stat -c %s "$WORK/$TAR") * 100 / size ))
		fi
		sleep 1
	done
	wait "$pid"
else
	curl -fsSL -o "$WORK/$TAR" "$URL/$TAR"
fi
curl -fsSL -o "$WORK/$VERITY" "$URL/$VERITY"
( cd "$WORK" && sha256sum -c --ignore-missing --quiet SHA256SUMS )

echo ">>> Writing slot $OTHER ($DEV)"
prog installing
M=/run/aos-update
# GRUB must not be pointed at this slot while it is being written, and
# the slot's menu entry goes with its ESP directory: cleared first, set
# last; in between the machine boots what it runs now, whatever happens
# to the slot. A run that dies mid-way (a power-off, an error under
# set -e) must not leave the core open; every command in the trap is
# allowed to fail, or a completed update would report umount's status.
grub-editenv "$GRUBENV" unset next
rm -rf "$ESPAOS/$OTHER"
trap 'slot_umount_core "$M" aos-update 2>/dev/null || true; rm -rf "$WORK" || true' EXIT
# An idle slot is nobody's to mount, but a stick's partitions are USB
# media to udev, and the removable-media rule has mounted one under
# /run/media before (the G14, 2026-10-01).
while m=$(findmnt -n -o TARGET --first-only "$DEV"); do
	echo "    unmounting $m first"
	umount "$m"
done
slot_write_core "$DEV" "$WORK/$TAR" "$WORK/$VERITY" || { echo "aos-update: the core did not verify on $DEV" >&2; exit 1; }
rm -f "$WORK/$TAR"
slot_read_verity "$WORK/$VERITY"
slot_mount_core "$DEV" "$VHASH" "$VOFFSET" "$M" aos-update || { echo "aos-update: cannot open the new core" >&2; exit 1; }

# The core is the live image's: the live account's leave is in its /etc
# (/etc/sudoers.d/20-aos-live, /etc/aos/live), and the overlay's upper
# copy is what counts on an installed machine; aos-install dropped them
# there. A machine that runs with them -- a demo install -- keeps them.
if [ ! -e /etc/aos/live ]; then
	rm -f /etc/sudoers.d/20-aos-live /etc/aos/live
fi

# Accounts the new release adds -- a system user for a new service, say --
# would be hidden by the copies of passwd and group the overlay holds once
# anything on this machine changed them. Append what is new by name --
# except the live medium's own account, admin, which aos-install deleted
# on an owned machine: appended back it shared uid 1000 with the owner and
# the login screen listed it (the G14, 2026-10-07). An admin line a
# previous update left behind goes the same way.
# ponytail: name-based append only; a UID the image changed is not followed.
for f in passwd group shadow gshadow; do
	[ -f "$M/etc/$f" ] && [ -f "/etc/$f" ] || continue
	if [ ! -e /etc/aos/live ]; then
		sed -i '/^admin:/d' "/etc/$f"
	fi
	awk -F: -v live="$([ -e /etc/aos/live ] && echo yes)" \
		'NR == FNR { have[$1] = 1; next } !($1 in have) && (live == "yes" || $1 != "admin")' \
		"/etc/$f" "$M/etc/$f" >> "/etc/$f"
done
# Last: the ESP's share of the slot, verity.cfg at its end, which is what
# --rollback and GRUB's menu look for.
slot_stage_esp "$OTHER" "$M" "$VHASH" "$VOFFSET"
slot_umount_core "$M" aos-update
trap 'rm -rf "$WORK" || true' EXIT
grub-editenv "$GRUBENV" set "next=$OTHER"
echo "AOS $NEW_VER is installed in slot $OTHER and boots at the next restart"
prog done
# What the shell and the store read: the release is no longer waiting to
# be fetched, it is waiting for the restart (aos-update-check writes the
# same line on its next run).
U=/var/lib/aos/updates
if [ -f "$U" ] && grep -q "^AOS $NEW_VER is available" "$U"; then
	sed -i "s/^AOS $NEW_VER is available.*/AOS $NEW_VER is installed; restart to finish/" "$U" 2>/dev/null || true
fi
