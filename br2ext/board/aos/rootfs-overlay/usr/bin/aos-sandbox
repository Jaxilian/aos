#!/bin/sh
#
# aos-sandbox -- run a program in its own mount and pid namespace, seeing
# the OS read-only, the packages it was given, its home, and the session's
# sockets. What third-party software runs in when its ABI is not ours, or
# when it should not see the store: the sandbox exists because an ELF
# interpreter path is absolute, and /lib/ld-linux.so.2 can mean something
# in here without existing on AOS.
#
#   aos-sandbox [--app ORG/NAME] [--home private|full] [--share DIR]... [--no-net]
#               [--camera] [--package ORG/NAME]... [--lib32 ORG/NAME] [--no-home]
#               -- COMMAND [ARG]...
#
# apm writes the call for a package with a [sandbox] section in its
# manifest (its farm entry and its desktop entry), so what the store says
# a program sees is what it sees (docs/security-model.md):
#
#   --app ORG/NAME     names the program; --home private gives it a home
#                      of its own, ~/.var/app/ORG.NAME, bound at $HOME so
#                      the program sees the usual path and nothing else of
#                      the real home. --home full is the person's home.
#   --share DIR        with a private home: this directory of the real
#                      home, read-write, at the same place (Downloads).
#   --no-net           no network at all.
#   --camera           the cameras, /dev/video*; without it a program
#                      has none (Software's Permissions, "Camera").
#
# bubblewrap does the namespaces, unprivileged: user namespaces are on in
# the kernel and bwrap is not setuid here (external.mk). The view inside:
#
#   /usr /etc /sys     the OS, read-only -- glibc, Mesa, the Vulkan loader,
#                      fonts, CA certificates are the host's own
#   /opt/apm/packages/<org>/<name>
#                      each package named with --package, at its store
#                      path, so the paths written into its wrappers and
#                      caches resolve unchanged; runtimes and dependencies
#                      are packages too
#   /lib               with --lib32, that package's lib/ -- a 32-bit glibc
#                      with its loader at /lib/ld-linux.so.2, the path a
#                      32-bit ELF names; 64-bit programs go on finding
#                      theirs in /usr/lib and /lib64, and each loader skips
#                      the other's class. Without it, /lib is /usr/lib.
#   $HOME              read-write; --no-home gives a private, empty one
#   $XDG_RUNTIME_DIR   the session's Wayland, PipeWire and D-Bus sockets
#   /tmp/.X11-unix     XWayland's socket, when the xwayland package is
#                      installed and the compositor started it
#   /run/udev /run/dbus /run/systemd/resolve
#                      device enumeration for SDL and libinput, the system
#                      bus, and the resolver: /etc/resolv.conf is a symlink
#                      into the last, and /run in here is otherwise empty --
#                      without it a program has no DNS and reports every
#                      server as unreachable
#   /run/media         removable drives, read-write, as the media rule
#                      mounts them: a game library on a second stick
#   /dev/dri /dev/snd /dev/input
#                      the GPU, the sound card, controllers -- through the
#                      ACL logind set for the seat, since the uid is kept
#   /dev/nvidia*       an NVIDIA GPU's own nodes, which its userspace uses
#                      beside /dev/dri; world-accessible as the driver makes
#                      them
#   /proc /tmp /run    this sandbox's own
#
# IPC is not unshared: X11's MIT-SHM and some game launchers use System V
# shared memory to talk to a server outside, and the point here is what a
# program sees on disk, not that.
#
# Not visible: the rest of /opt/apm (other packages, the store's state,
# the bin farm -- so a program is named by its store path), other
# accounts' homes, /root, /var, /boot. Programs run as the same uid; this
# is isolation of what they can see, not of who they are.

set -e

BINDS=""
NOHOME=no
APP=""
HOMEMODE=full
SHARES=""
NET=""
CAM=no
LIB="--symlink usr/lib /lib"
while [ $# -gt 0 ]; do
	case "$1" in
		--app) APP="$2"; shift ;;
		--home)
			case "$2" in
				private|full) HOMEMODE="$2" ;;
				*) echo "aos-sandbox: --home takes private or full" >&2; exit 64 ;;
			esac
			shift ;;
		--share)
			case "$2" in
				""|/*|.*|*/*) echo "aos-sandbox: --share takes a directory name in the home: Downloads" >&2; exit 64 ;;
			esac
			SHARES="$SHARES $2"
			shift ;;
		--no-net) NET="--unshare-net" ;;
		--camera) CAM=yes ;;
		--lib32)
			d="/opt/apm/packages/$2/current/lib"
			[ -f "$d/ld-linux.so.2" ] || { echo "aos-sandbox: $2 has no lib/ld-linux.so.2" >&2; exit 66; }
			LIB="--ro-bind $d /lib"
			shift ;;
		--package|--runtime)
			d="/opt/apm/packages/$2"
			[ -d "$d" ] || { echo "aos-sandbox: no package $2 in the store" >&2; exit 66; }
			BINDS="$BINDS --ro-bind $d $d"
			shift ;;
		--no-home) NOHOME=yes ;;
		--) shift; break ;;
		-*) echo "aos-sandbox: unknown option $1" >&2; exit 64 ;;
		*) break ;;
	esac
	shift
done
[ $# -gt 0 ] || { echo "usage: aos-sandbox [--package ORG/NAME]... [--no-home] -- COMMAND [ARG]..." >&2; exit 64; }

# This person's say over the declaration: Settings -> Programs writes
# ~/.config/aos/sandbox/ORG.NAME, one line in apm's compact form
# (`private:Downloads,Pictures`, `full`, `...;nonet`, `...;cam`), and it
# replaces the flags apm wrote. Anything malformed is ignored, not
# half-applied.
if [ -n "$APP" ]; then
	OVR="${XDG_CONFIG_HOME:-$HOME/.config}/aos/sandbox/$(echo "$APP" | tr / .)"
	if [ -f "$OVR" ]; then
		line=$(head -n 1 "$OVR" | tr -d ' \t\r')
		onet=""
		ocam=no
		# The suffixes, in any order.
		while :; do
			case "$line" in
				*';nonet') onet="--unshare-net"; line=${line%;nonet} ;;
				*';cam') ocam=yes; line=${line%;cam} ;;
				*) break ;;
			esac
		done
		ohome=${line%%:*}
		oshare=""
		case "$line" in *:*) oshare=$(echo "${line#*:}" | tr , ' ') ;; esac
		good=yes
		case "$ohome" in private|full) ;; *) good=no ;; esac
		for d in $oshare; do
			case "$d" in ""|/*|.*|*/*) good=no ;; esac
		done
		if [ "$good" = yes ]; then
			HOMEMODE=$ohome
			SHARES=$oshare
			NET=$onet
			CAM=$ocam
		else
			echo "aos-sandbox: $OVR is not a declaration; using the package's" >&2
		fi
	fi
fi

# The home: read-write, or a fresh tmpfs. Account names are validated by
# aos-install (lowercase, digits, - and _), so $HOME never needs quoting
# through the word-split below.
if [ "$NOHOME" = yes ]; then
	HOME_BIND="--tmpfs $HOME"
elif [ "$HOMEMODE" = private ]; then
	[ -n "$APP" ] || { echo "aos-sandbox: --home private needs --app ORG/NAME" >&2; exit 64; }
	# Flatpak's layout, so a program that knows it behaves; one directory
	# per program, the person's own, nothing of the real home inside it
	# but what --share names.
	PRIV="$HOME/.var/app/$(echo "$APP" | tr / .)"
	mkdir -p "$PRIV"
	chmod 700 "$PRIV"
	HOME_BIND="--bind $PRIV $HOME"
	for d in $SHARES; do
		mkdir -p "$HOME/$d"
		HOME_BIND="$HOME_BIND --bind $HOME/$d $HOME/$d"
	done
else
	HOME_BIND="--bind $HOME $HOME"
fi
CAMERAS=""
if [ "$CAM" = yes ]; then
	for v in /dev/video[0-9]* /dev/media[0-9]*; do
		[ -e "$v" ] && CAMERAS="$CAMERAS --dev-bind $v $v"
	done
fi
NVIDIA=""
for n in /dev/nvidiactl /dev/nvidia[0-9]* /dev/nvidia-uvm /dev/nvidia-uvm-tools /dev/nvidia-modeset; do
	[ -e "$n" ] && NVIDIA="$NVIDIA --dev-bind $n $n"
done
RUN_BIND=""
[ -n "$XDG_RUNTIME_DIR" ] && [ -d "$XDG_RUNTIME_DIR" ] && RUN_BIND="--bind $XDG_RUNTIME_DIR $XDG_RUNTIME_DIR"

# shellcheck disable=SC2086
exec bwrap \
	--ro-bind /usr /usr \
	--symlink usr/bin /bin --symlink usr/sbin /sbin \
	$LIB --symlink usr/lib /lib64 \
	--ro-bind /etc /etc \
	--ro-bind /sys /sys \
	--proc /proc --dev /dev --tmpfs /tmp --tmpfs /run \
	--dev-bind-try /dev/dri /dev/dri \
	--dev-bind-try /dev/snd /dev/snd \
	--dev-bind-try /dev/input /dev/input \
	$NVIDIA $CAMERAS \
	--ro-bind-try /run/udev /run/udev \
	--ro-bind-try /run/dbus /run/dbus \
	--ro-bind-try /run/systemd/resolve /run/systemd/resolve \
	--bind-try /run/media /run/media \
	--ro-bind-try /tmp/.X11-unix /tmp/.X11-unix \
	$RUN_BIND $HOME_BIND $BINDS $NET \
	--unshare-pid --unshare-uts --die-with-parent \
	-- "$@"
