#!/bin/sh
#
# aos-update-check -- what updates exist, for the shell to tell the person.
#
# Run two minutes after boot and then daily by aos-update-check.timer, as
# root, and by Software's "Look for updates" through sudo (apm's index and the OS's
# release live in system places). Looks only: `apm update` refreshes the
# signed indexes, `apm --dry-run upgrade` lists what an upgrade would do
# and, through aos-update --check, whether a new AOS is out. Nothing is
# installed -- that stays the person's choice (docs/policies.md).
#
# Writes /var/lib/aos/updates for the shell and Software to read: the
# first line a count, the rest one line per update. An empty count is 0.
# Written on every run, so the shell's toast (once per boot, when the
# file is new since the boot and the count is not 0) comes back the next
# day a person leaves the updates waiting.

OUT=/var/lib/aos/updates
mkdir -p /var/lib/aos

apm --quiet update >/dev/null 2>&1 || exit 0
plan=$(apm --dry-run --quiet upgrade 2>/dev/null)

# A release already written into the idle slot is not "available": it is
# installed, and only the restart is left; the line says so, and the
# store shows Restart instead of Upgrade system for it.
lines=$(printf '%s\n' "$plan" | sed -n 's/^ *upgrade  *\([^ ]*\) .*/\1/p; s/^ *install  *\([^ ]*\) .*/\1 (new)/p; s/^\(AOS [0-9.]* is available\).*/\1/p; s/^AOS \([0-9.]*\) is already in slot .*/AOS \1 is installed; restart to finish/p')
n=$(printf '%s\n' "$lines" | grep -c .)

tmp=$OUT.new
{ echo "$n"; printf '%s\n' "$lines" | grep .; } > "$tmp"
chmod 644 "$tmp"
mv "$tmp" "$OUT"
printf '%s\n' "$lines" | grep . || echo "everything is up to date"
