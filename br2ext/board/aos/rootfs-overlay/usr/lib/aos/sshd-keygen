#!/bin/sh
#
# Make sure sshd has host keys, wherever they can be written.
#
# Buildroot's sshd.service runs "ssh-keygen -A", which only ever writes to
# /etc/ssh. That works on an installed system and fails on the live ISO,
# whose /etc is read-only -- and sshd with no host key at all refuses to
# start. So: use /etc/ssh when it is writable, and a tmpfs under /run
# otherwise. Both paths are listed in sshd_config.
#
# A key is only trusted if it has a size. The first boot after an install
# generates the keys, and if that boot ends in a power cut before ext4 has
# flushed them, delayed allocation leaves zero-byte files behind -- which
# "-f" would accept, and sshd would then die at every boot after. So an
# empty key is regenerated, and a fresh key is written under another name,
# forced to disk, and only then renamed into place.

set -e

if mkdir -p /etc/ssh 2>/dev/null && [ -w /etc/ssh ]; then
	dir=/etc/ssh
else
	dir=/run/ssh
	mkdir -p "$dir"
fi
chmod 0755 "$dir"

for type in ed25519 rsa; do
	key="${dir}/ssh_host_${type}_key"
	[ -s "$key" ] && continue
	rm -f "$key" "$key.pub" "$key.new" "$key.new.pub"
	ssh-keygen -q -t "$type" -f "$key.new" -N "" -C "root@aos"
	sync
	mv "$key.new.pub" "$key.pub"
	mv "$key.new" "$key"
	sync
done
