#!/bin/sh
#
# zram-setup -- compressed swap in RAM: half of memory, at most 8 GB,
# zstd, priority 100 so the kernel fills it before the on-disk swap file
# (pri=10) that aos-install adds to /etc/fstab on an installed system.
#
# Runs after the desktop has started, not before: as a swap unit under
# swap.target it was on the way to sysinit.target and cost the desktop
# 1.3 s on the G14 (modprobe and sizing the device). Nothing needs swap
# in the first seconds of a boot.

set -e
mem_kb=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo)
size_kb=$((mem_kb / 2))
max_kb=$((8 * 1024 * 1024))
[ "$size_kb" -gt "$max_kb" ] && size_kb=$max_kb
modprobe zram
zramctl /dev/zram0 --algorithm zstd --size "${size_kb}K"
mkswap -q -L zram0 /dev/zram0
swapon -p 100 /dev/zram0
