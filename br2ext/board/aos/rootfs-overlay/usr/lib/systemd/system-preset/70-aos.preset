# Buildroot runs `systemctl preset-all` when it assembles the filesystem,
# after post-build.sh, and systemd's rule for a unit no preset names is
# "enable": that is how sshd came up on every image, key or no key. Off
# here; a build with board/aos/authorized_keys gets a 60-aos-ssh.preset
# from post-build.sh that says enable, and Settings -> Network enables it
# on an installed machine. docs/security-model.md.
disable sshd.service
# The login daemon: an owned or an OOBE install enables it; the live
# medium and a demo install run ade.service instead.
disable greetd.service
# Homes: every owner and later account is a systemd-homed home, a LUKS2
# image under /home unlocked by its password at login (docs/layout.md).
# homed's own first-boot wizard asks on the console and holds back logins
# until it is answered; AOS asks in aos-setup's first boot instead.
enable systemd-homed.service
enable systemd-homed-activate.service
enable systemd-userdbd.service
disable systemd-homed-firstboot.service
