# The core is read-only and the initramfs mounts everything else before
# systemd starts (docs/layout.md): the aos partition at /aos, /var, the
# /etc overlay, /opt/apm, /home and the ESP; systemd adopts those mounts.
# An installed system's swap file is a line aos-install adds to this file
# in the /etc overlay, so it is a line of that machine, not of the core.
tmpfs			/tmp		tmpfs		defaults		0	0
