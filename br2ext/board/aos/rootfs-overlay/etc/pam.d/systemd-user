# Used by logind when it starts user@UID.service for a new session. systemd
# installs a copy of its own; this one exists so the file is under our
# control and only names PAM modules that are actually on the image.
# pam_systemd_home: the account's services run with its home unlocked.
account		sufficient	pam_systemd_home.so
account		required	pam_unix.so
session		required	pam_limits.so
session		optional	pam_systemd_home.so
session		optional	pam_systemd.so
