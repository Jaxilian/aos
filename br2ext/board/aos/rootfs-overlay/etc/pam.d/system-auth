# The stack passwd, chpasswd, chfn and chsh include. Buildroot's shadow
# ships those files with "include system-auth" and no system-auth, so every
# password change failed with PAM's "Permission denied" -- the installer's
# chpasswd in the chroot, Settings' "Set the password", passwd itself. The
# same pam_unix lines login uses; sha512 for new hashes.
auth		required	pam_unix.so nullok
account		required	pam_unix.so
password	required	pam_unix.so sha512 shadow nullok
session		required	pam_unix.so
