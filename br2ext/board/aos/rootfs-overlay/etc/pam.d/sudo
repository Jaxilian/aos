# sudo: Buildroot's stack (wheel only, the caller's own password) with
# pam_systemd_home first, so a homed account's password is checked by
# homed. A classic account falls through to pam_unix as before.
auth		sufficient	pam_rootok.so
auth		required	pam_wheel.so use_uid
auth		required	pam_env.so
# pam_unix once first, its result ignored: it asks for the password (an
# account with none, like the greeter's, is not asked) and caches it, so
# pam_systemd_home's call carries the password. Without it the module
# first asks homed with no password; against a home already active (sudo,
# the lock screen, a second login) homed books that as a failed attempt,
# is busy writing the record when the real password follows, and after
# five immediate retries the module refuses. No jumps: every path ends
# in pam_unix, so pam_setcred succeeds (greetd treats IGNORE as fatal).
auth		[success=ignore default=ignore]	pam_unix.so nullok
auth		sufficient	pam_systemd_home.so
auth		required	pam_unix.so nullok try_first_pass
account		sufficient	pam_systemd_home.so
account		required	pam_unix.so
password	required	pam_unix.so nullok
session		required	pam_limits.so
session		required	pam_env.so
session		required	pam_unix.so
