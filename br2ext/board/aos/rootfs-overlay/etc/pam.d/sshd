# An SSH login, like a console login, becomes a logind session: pam_systemd
# is what gives it a seat and an XDG_RUNTIME_DIR. Authentication is by key,
# handled by sshd itself, so the auth stack only has to not get in the way.
auth		required	pam_unix.so nullok
account		required	pam_unix.so
session		required	pam_limits.so
session		required	pam_env.so
session		required	pam_unix.so
session		optional	pam_systemd.so
