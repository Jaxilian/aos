# The firewall: /etc/nftables.conf, loaded before any interface comes up.
# Buildroot's nftables package ships only a SysV script, hence this unit.
[Unit]
Description=Firewall (nftables)
Documentation=man:nft(8)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target
ConditionPathExists=/etc/nftables.conf

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nft -f /etc/nftables.conf
ExecReload=/usr/bin/nft -f /etc/nftables.conf
ExecStop=/usr/bin/nft delete table inet filter

[Install]
WantedBy=sysinit.target
