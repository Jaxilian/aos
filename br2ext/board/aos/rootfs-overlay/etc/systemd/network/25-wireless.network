# Wireless interfaces on DHCP, once wpa_supplicant has associated. `aos-wifi
# SSID` writes the network into /etc/wpa_supplicant/wpa_supplicant-<iface>.conf
# and enables wpa_supplicant@<iface>; the interface is named by the kernel and
# networkd (wlo1, wlp2s0, ...), not wlan0.
[Match]
Name=wl*

[Network]
DHCP=yes
