#!/bin/sh
#
# On the live ISO the root filesystem is read-only, but /var is not a tmpfs
# and syslogd, dhcpcd and crond all expect to write into it. Give /var a
# tmpfs and repopulate it from the read-only copy underneath.
#
# On an installed system the root is read-write and this does nothing.
#
# /etc is deliberately left alone: remounting it here would pull the
# directory out from under rcS while it is still iterating /etc/init.d.
# The one file that genuinely needs to be writable, resolv.conf, is a
# symlink into /run instead.

case "$1" in
	start)
		# Only act on a read-only root.
		grep -qE ' / [^ ]+ ro[, ]' /proc/mounts || exit 0

		printf 'Setting up writable /var: '
		mkdir -p /run/var-factory
		cp -a /var/. /run/var-factory/ 2>/dev/null
		if mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /var; then
			cp -a /run/var-factory/. /var/ 2>/dev/null
			rm -rf /run/var-factory
			echo "OK"
		else
			rm -rf /run/var-factory
			echo "FAILED"
			exit 1
		fi
		;;
	stop|restart|reload)
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
