# Applied on top of the mainline x86_64_defconfig.
#
# Only put here what the mainline defconfig does not already give us.
# M2 grows this considerably (DRM, wifi, legacy PATA, filesystems);
# for M0 we only assert the handful of options Buildroot's userland
# depends on, so that a defconfig change upstream cannot silently
# break the boot. systemd's own requirements -- cgroups, inotify,
# signalfd, autofs, seccomp and so on -- are forced on by Buildroot's
# package/systemd when the kernel is configured and need no lines here.

# Device nodes: udev needs devtmpfs mounted before it starts.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- systemd -----------------------------------------------------------------
# Buildroot's package/systemd forces on the options systemd cannot run
# without. These are the ones it runs *worse* without: unit-file resource
# control and sandboxing (memory, pids, io, device and BPF cgroup
# controllers), oomd's pressure signal, coredump/pstore capture, and
# binfmt. Each degrades silently when absent, so they are asserted here.
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_PSI=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_KCMP=y
CONFIG_BINFMT_MISC=m
CONFIG_PSTORE=y
CONFIG_EFI_VARS_PSTORE=y
CONFIG_AUDIT=y

# --- Swap ----------------------------------------------------------------------
# zram is the primary swap device on every AOS system, including the live
# ISO, which has no disk to swap to at all. zstd rather than the lzo-rle
# default: a noticeably better ratio, and the x86-64-v2 baseline guarantees
# a CPU that can afford it. The device is set up by zram-setup.service in
# the rootfs overlay; the on-disk swap file is added by aos-install.
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y

# Module loading. Hardware support is shipped as modules so the kernel
# image stays small and udev loads only what the machine actually has.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Filesystems the live ISO and the installer need (M5).
CONFIG_EXT4_FS=y
CONFIG_ISO9660_FS=y
CONFIG_SQUASHFS=y
CONFIG_OVERLAY_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# EFI variable access, needed by efibootmgr during install.
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y

# Console fallbacks: these are what make the image come up on machines
# whose GPU has no DRM driver, or before the DRM module is loaded.
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_FRAMEBUFFER_CONSOLE=y

################################################################################
# M2 -- hardware breadth.
#
# Everything hardware-specific is a module (=m): the kernel image stays small
# and udev loads only what the machine actually has. The handful of =y entries
# are the ones needed before any module can load, or to get a console at all.
################################################################################

# --- GPU / DRM -------------------------------------------------------------
# i915 covers Intel up to Gen12; xe is the newer driver and is what a Panther
# Lake (Xe3) part needs. Both are present because which one binds depends on
# the generation.
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_VMWGFX=m
CONFIG_DRM_QXL=m
CONFIG_DRM_BOCHS=m
CONFIG_DRM_VIRTIO_GPU=m
# Gives a working framebuffer console on any GPU with no native driver.
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y

# --- Storage ---------------------------------------------------------------
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB_STORAGE=y
CONFIG_MMC=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
# Legacy PATA, for the genuinely old machines in scope.
CONFIG_ATA_GENERIC=y
CONFIG_PATA_LEGACY=m
CONFIG_PATA_VIA=m
CONFIG_PATA_AMD=m
CONFIG_PATA_SIS=m
CONFIG_PATA_ALI=m

# --- Filesystems -----------------------------------------------------------
CONFIG_BTRFS_FS=m
CONFIG_XFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_FUSE_FS=m
CONFIG_NFS_FS=m

# --- Wired network ---------------------------------------------------------
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_R8169=m
CONFIG_TIGON3=m
CONFIG_ATL1C=m
CONFIG_SKY2=m
CONFIG_VIA_RHINE=m

# --- Wireless --------------------------------------------------------------
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLDVM=m
CONFIG_ATH9K=m
CONFIG_ATH10K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_RTW88=m
CONFIG_RTW89=m
CONFIG_MT76x2E=m
CONFIG_MT7921E=m
CONFIG_BRCMFMAC=m
# Regulatory data is loaded as firmware; without this wifi comes up
# restricted to the most conservative channel set.
CONFIG_CFG80211_CRDA_SUPPORT=y

# --- Input / laptop --------------------------------------------------------
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_MULTITOUCH=m
CONFIG_ACPI_BUTTON=y
CONFIG_ACPI_BATTERY=m
CONFIG_ACPI_AC=m

# --- USB -------------------------------------------------------------------
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y

# --- NVIDIA prerequisites --------------------------------------------------
# The out-of-tree nvidia modules need these to be reachable. Without
# DRM_TTM_HELPER and the GPL symbols the module builds but will not link.
CONFIG_DRM_TTM=m
CONFIG_DRM_TTM_HELPER=m
CONFIG_MTRR=y
CONFIG_X86_PAT=y

# --- Live ISO --------------------------------------------------------------
# The live image stores its files zisofs-compressed and decompresses them on
# read, which is what keeps the ISO to a sensible size given Mesa, the Rust
# toolchain and the development sysroot are all on it.
CONFIG_ZISOFS=y
CONFIG_ZLIB_INFLATE=y

# --- Console on UEFI ----------------------------------------------------------
# Under UEFI there is no VGA text mode, so the only way to get a console on
# the screen is fbcon on top of a framebuffer. simpledrm takes the firmware
# framebuffer and the bochs/i915/xe/amdgpu drivers take over later, but a DRM
# driver provides an fbdev for fbcon to bind to ONLY with this set. Without it
# the console stays on the "colour dummy device" and the screen is black from
# the moment GRUB hands over, while the system runs fine on serial.
# Legacy BIOS boots were unaffected because vgacon needs no framebuffer,
# which is what made this hard to spot.
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# --- CPU frequency and idle ---------------------------------------------------
# The mainline x86_64_defconfig picks the "userspace" governor, which scales
# nothing unless a daemon drives it. intel_pstate and amd_pstate in active
# mode ignore the choice, but everything that falls back to acpi-cpufreq --
# the older hardware AOS explicitly targets, and virtual machines -- sits at
# one frequency forever. schedutil is what every distribution ships.
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE is not set
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_X86_ACPI_CPUFREQ=y
# Intel's own idle driver knows the real C-states; acpi_idle only knows what
# the firmware admits to.
CONFIG_INTEL_IDLE=y

# --- Microcode ----------------------------------------------------------------
# Applied early from /boot/microcode.img, a microcode-only initrd that
# post-build.sh assembles and GRUB hands to the kernel. There is no real
# initramfs: the kernel applies the microcode, finds no /init, and mounts the
# root from root= as it always has. Late loading stays off -- Intel documents
# it as unsafe on some parts.
CONFIG_MICROCODE=y
CONFIG_BLK_DEV_INITRD=y
# CONFIG_MICROCODE_LATE_LOADING is not set

# --- Watchdog -----------------------------------------------------------------
# A hardware watchdog turns a hung kernel into a reboot instead of a machine
# waiting for someone to hold the power button. systemd pets it
# (RuntimeWatchdogSec= in system.conf.d). iTCO is Intel's, WDAT the
# ACPI-described one on most modern boards, SP5100 AMD's, and i6300esb the
# device QEMU and libvirt give a virtual machine.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_LPC_ICH=m
CONFIG_ITCO_WDT=m
CONFIG_WDAT_WDT=m
CONFIG_SP5100_TCO=m
CONFIG_I6300ESB_WDT=m

# --- Panic and lockup policy --------------------------------------------------
# A panic reboots after ten seconds instead of sitting on a dead screen, and
# a hard lockup (a CPU that has stopped taking interrupts) is a panic. Soft
# lockups are logged, not fatal: they are usually a misbehaving driver rather
# than a dead machine. Same policy the major distributions use.
CONFIG_PANIC_TIMEOUT=10
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_HARDLOCKUP_PANIC=y
# CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC is not set
# CONFIG_PANIC_ON_OOPS is not set

# --- Hardware error reporting -------------------------------------------------
# Machine checks, ACPI platform errors (GHES) and the EDAC memory-controller
# drivers turn a failing DIMM or a flaky PCIe link into a journal entry that
# names the part, instead of silent corruption. amd64 covers AMD; the rest
# are Intel's controllers from Sandy Bridge to the current client parts.
CONFIG_X86_MCE=y
CONFIG_RAS=y
CONFIG_ACPI_APEI=y
CONFIG_ACPI_APEI_GHES=y
CONFIG_ACPI_APEI_PCIEAER=y
CONFIG_ACPI_APEI_MEMORY_FAILURE=y
CONFIG_MEMORY_FAILURE=y
CONFIG_PCIEAER=y
CONFIG_EDAC=y
CONFIG_EDAC_AMD64=m
CONFIG_EDAC_SBRIDGE=m
CONFIG_EDAC_SKX=m
CONFIG_EDAC_I10NM=m
CONFIG_EDAC_PND2=m
CONFIG_EDAC_IE31200=m
CONFIG_EDAC_IGEN6=m
# Temperature sensors, so thermal trouble is visible before it is fatal.
CONFIG_HWMON=y
CONFIG_SENSORS_CORETEMP=m
CONFIG_SENSORS_K10TEMP=m

# --- Memory-corruption detection ----------------------------------------------
# These make heap and list corruption fail loudly and at once, instead of
# propagating until something unrelated falls over. The cost is a percent or
# two; Fedora's kernel carries the same set.
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_DEBUG_LIST=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
