# The 32-bit userspace, for the sandbox and nothing else.
#
# A third Buildroot configuration, for a third output tree:
#
#   make O=$PWD/output-compat32 BR2_EXTERNAL=$PWD/br2ext aos_compat32_defconfig
#   make O=$PWD/output-compat32
#
# It produces no image. What it produces is an i686 target tree from which
# board/aos/br2apkg.py lifts runtime/compat32 into a .apkg: a 32-bit
# glibc, its loader, libstdc++ and libgcc, and later a 32-bit Mesa. What
# needs it is Steam, whose Linux client is still a 32-bit binary with
# /lib/ld-linux.so.2 as its interpreter -- an absolute path, baked in --
# and the only place that path may mean something on AOS is inside
# aos-sandbox. Nothing here enters the image, ever; Valve moved the
# Windows client to 64-bit in 2025, and the day the Linux one follows this
# configuration and its package are deleted.
#
# Its own toolchain, because Buildroot cannot build a multilib one and the
# SDK is x86-64 only. Same gcc and glibc versions as the image, so a
# program compiled by both has the same C++ ABI on either side of the
# sandbox boundary.

BR2_i386=y
# Every x86-64 CPU has SSE2; plain i686 would leave 32-bit maths on x87.
BR2_x86_pentium4=y

BR2_TOOLCHAIN_BUILDROOT=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_GCC_VERSION_15_X=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_7_1=y

# No system, no image: only packages.
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_TARGET_ROOTFS_TAR is not set
# BR2_PACKAGE_BUSYBOX is not set

# What every 32-bit binary links besides libc.
BR2_PACKAGE_ZLIB=y

# A 32-bit libGL. Steam's steamui.so links the GLX flavour of it and will
# not load without one, so here is Mesa with GLX through libglvnd, and the
# X client libraries GLX is made of. softpipe is its one driver: no LLVM
# in 32-bit, and what the client itself draws with it is a login window.
# A 32-bit game gets software GL until a 32-bit hardware driver is worth
# its build; 64-bit games, which is nearly all of them under Proton, use
# the image's own Vulkan and never come here.
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBGLVND=y
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XLIB_LIBX11=y
BR2_PACKAGE_XLIB_LIBXEXT=y
BR2_PACKAGE_XLIB_LIBXFIXES=y
BR2_PACKAGE_XLIB_LIBXDAMAGE=y
BR2_PACKAGE_XLIB_LIBXXF86VM=y
BR2_PACKAGE_XLIB_LIBXRANDR=y
BR2_PACKAGE_XLIB_LIBXSHMFENCE=y
BR2_PACKAGE_XLIB_LIBXRENDER=y
BR2_PACKAGE_XLIB_LIBXI=y

# The rest of what Valve's own launcher package lists as the host's 32-bit
# side (debian/control, steam-libs-i386), and what the client asked for
# first: libnsl, which glibc no longer ships and Buildroot does not
# package -- br2ext/package/libnsl -- and libcrypt, likewise out of glibc.
# eudev only for its libudev; controllers are found through it.
BR2_PACKAGE_LIBNSL=y
BR2_PACKAGE_LIBXCRYPT=y
BR2_PACKAGE_LIBGPG_ERROR=y
BR2_PACKAGE_XLIB_LIBXINERAMA=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_EUDEV=y
