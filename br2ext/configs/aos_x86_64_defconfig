# AOS x86_64 - milestone M0: skeleton that boots to a shell.
#
# Later milestones layer on top of this file:
#   M1 GNU userland, M2 hardware breadth, M3 graphics,
#   M4 self-hosting toolchain, M5 live ISO + installer.

# Architecture: x86-64-v2 baseline (~2009+ CPUs, SSE4.2/POPCNT).
BR2_x86_64=y
BR2_x86_x86_64_v2=y

# Toolchain. glibc is non-negotiable: it is part of the platform ABI
# AOS promises, and the NVIDIA blob and the Rust dist both require it.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_GCC_VERSION_15_X=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# System.
BR2_TARGET_GENERIC_HOSTNAME="aos"
BR2_TARGET_GENERIC_ISSUE="AOS - kernel, libc, drivers. The rest is yours."
# Init is systemd. It is what the software people will build on AOS expects
# to find underneath it -- units, journald, logind, udev, D-Bus, networkd --
# and the point of a foundation is that nothing above it has to be taught a
# second, non-standard way to start, log and find its seat.
#
# systemd brings its own udev. The /dev management choice is hidden while
# BR2_INIT_SYSTEMD is set, which is why there is no eudev line here.
BR2_INIT_SYSTEMD=y
# Login on both the screen and the serial line. GETTY_PORT names the virtual
# console explicitly; systemd's getty generator adds a serial getty for every
# console= on the kernel command line by itself. ("console" here would make
# Buildroot disable getty@tty1, leaving the screen without a login.)
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
# The live ISO is read-only, so do not try to remount / read-write. An
# installed system is mounted read-only by the kernel too ("ro" on its
# command line), checked by systemd-fsck-root, and then made writable by
# systemd-remount-fs from its /etc/fstab line -- the only way the root ever
# gets an fsck without an initramfs.
# With this off Buildroot builds a /var "factory": on the ISO /var is a tmpfs
# that systemd-tmpfiles populates from /usr/share/factory/var at boot. The
# var.mount drop-in in the rootfs overlay turns that tmpfs off once the root
# is writable, so an installed system keeps its real /var.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_INIT_SYSTEMD_VAR_FACTORY=y
# No BusyBox at all. Everything it used to cover has a real replacement:
# init, udev and logging (systemd), sh (bash), login and passwd (shadow), su
# (util-linux), ping (iputils), vi (vim), bzip2.
# BR2_PACKAGE_BUSYBOX is not set
BR2_SYSTEM_BIN_SH_BASH=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_AOS_PATH)/board/aos/rootfs-overlay"
# Groups that udev rules expect and Buildroot does not create -- see the file.
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_AOS_PATH)/board/aos/users_table.txt"

# systemd runs the core, deliberately and in full. AOS is not trying to be
# small; it is trying to be the base that is hardest to knock over, and the
# whole systemd ecosystem -- one supervisor, one log, one seat manager, one
# network stack, one OOM policy -- is the most widely tested way to get
# there. journald, udev, hwdb, vconsole, hostnamed, timedated, timesyncd,
# networkd and resolved are Buildroot's defaults; the rest is below.
#
# logind gives a login session its seat and XDG_RUNTIME_DIR; a Wayland
# compositor and its clients need both. polkit is what lets a user at that
# seat power the machine off or manage units without being root.
BR2_PACKAGE_SYSTEMD_LOGIND=y
BR2_PACKAGE_SYSTEMD_POLKIT=y
# oomd kills the offending cgroup on memory pressure before the kernel OOM
# killer has to pick something at random. Needs PSI and memcg (asserted in
# linux.config.fragment; Buildroot forces them on too).
BR2_PACKAGE_SYSTEMD_OOMD=y
# localectl, so locale and keymap are managed the same way as everything
# else. machined + nspawn: run an AOS tree, or anything else, as a container
# -- the cheapest place to test a package or an init change.
BR2_PACKAGE_SYSTEMD_LOCALED=y
BR2_PACKAGE_SYSTEMD_MACHINED=y
BR2_PACKAGE_SYSTEMD_NSPAWN=y
# sysext layers extension images over the read-only /usr; repart partitions
# disks from declarative repart.d files. Both are the modern primitives an
# image-based update story is built from, and a package manager for AOS may
# well want them.
BR2_PACKAGE_SYSTEMD_SYSEXT=y
BR2_PACKAGE_SYSTEMD_REPART=y
BR2_PACKAGE_SYSTEMD_EFI=y
BR2_PACKAGE_SYSTEMD_BINFMT=y
BR2_PACKAGE_SYSTEMD_USERDB=y
BR2_PACKAGE_SYSTEMD_ANALYZE=y
BR2_PACKAGE_SYSTEMD_BACKLIGHT=y
BR2_PACKAGE_SYSTEMD_RFKILL=y
BR2_PACKAGE_SYSTEMD_COREDUMP=y
BR2_PACKAGE_SYSTEMD_RANDOMSEED=y
# dbus-broker instead of the reference daemon: same protocol, a fraction of
# the latency, and what the major distributions ship. Buildroot drops the
# reference daemon automatically when this is set.
BR2_PACKAGE_DBUS_BROKER=y
# Sandboxing directives in unit files (SystemCallFilter= and friends) need
# libseccomp; without it they are silently ignored.
BR2_PACKAGE_LIBSECCOMP=y

# Kernel: latest upstream, seeded from the mainline x86_64 defconfig so we
# inherit its broad PC hardware coverage, then narrowed/widened by our
# fragment. Do not replace this with a hand-written full config.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_AOS_PATH)/board/aos/linux.config.fragment"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# Filesystem. M5 replaces this with the hybrid BIOS+UEFI ISO.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="4G"

################################################################################
# M1 -- GNU userland.
#
# The real GNU tools, with no BusyBox to fall back on. This is not
# preference: BusyBox applets diverge from GNU in ways that break
# ./configure, cargo build.rs and kbuild, and a self-hosting image has to
# survive all three.
################################################################################
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_GAWK=y
BR2_PACKAGE_SED=y
BR2_PACKAGE_GREP=y
BR2_PACKAGE_FINDUTILS=y
BR2_PACKAGE_DIFFUTILS=y
BR2_PACKAGE_TAR=y
BR2_PACKAGE_GZIP=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_ZSTD=y
BR2_PACKAGE_PATCH=y
BR2_PACKAGE_FLEX=y
BR2_PACKAGE_WHICH=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_PKGCONF=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_READLINE=y
BR2_PACKAGE_MAKE=y

# binutils supplies as and ld. Free here, and aos-gcc is useless without it.
BR2_PACKAGE_BINUTILS=y
BR2_PACKAGE_BINUTILS_TARGET=y

# Process and module handling. systemd needs kmod, and a modular kernel is
# central to the "boots on anything" goal.
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_PSMISC=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
# mount/umount: systemd selects them anyway, and the fstab that aos-install
# writes uses UUID= entries, which util-linux mount resolves.
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
# su, with PAM. shadow below is deliberately built without its own.
BR2_PACKAGE_UTIL_LINUX_SU=y
# zramctl configures the compressed swap device (see board/aos/rootfs-overlay
# and the Swap section of linux.config.fragment).
BR2_PACKAGE_UTIL_LINUX_ZRAMCTL=y
# Accounts: login, passwd, useradd and friends. PAM-enabled, so a console
# login registers with logind -- see rootfs-overlay/etc/pam.d/login.
BR2_PACKAGE_LINUX_PAM=y
BR2_PACKAGE_SHADOW=y

# Needed by aos-install: partitioning, filesystems, EFI boot entries.
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_DOSFSTOOLS=y
# The sub-options are not implied by the package. Without MKFS_FAT there
# is no mkfs.fat and aos-install cannot format the EFI system partition.
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
# Console keymaps. kbd provides loadkeys and the keymap files for every
# common layout; systemd-vconsole-setup applies the one named in
# /etc/vconsole.conf at boot.
BR2_PACKAGE_KBD=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_EFIBOOTMGR=y
# Things BusyBox used to cover. An editor above all: a machine you are meant
# to write an operating system on cannot ship without one.
BR2_PACKAGE_VIM=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_BZIP2=y

################################################################################
# M2 -- networking userland.
#
# Whoever writes the package manager needs a working TLS fetch on first boot,
# so openssl, a CA bundle and curl are part of the foundation, not extras.
#
# Addresses and DNS come from systemd-networkd and systemd-resolved, which
# Buildroot enables with BR2_INIT_SYSTEMD; the .network files in the rootfs
# overlay put every wired and wireless interface on DHCP.
################################################################################
BR2_PACKAGE_IPROUTE2=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
# SSH. The intended way to work on AOS is to install it on real hardware and
# then drive it from another machine -- a foundation has no desktop to sit at,
# and a real machine is the only place the drivers, the GPU and the microcode
# are actually exercised. Key authentication only: the root account has no
# password, and sshd rejects empty ones. Put a public key in
# br2ext/board/aos/authorized_keys before building (see docs/ssh.md).
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_CLIENT=y
# ssh-keygen, which sshd's own start-up needs to make its host keys.
BR2_PACKAGE_OPENSSH_KEY_UTILS=y
BR2_PACKAGE_OPENSSH_SANDBOX=y

################################################################################
# M2 -- firmware.
#
# Selected per vendor rather than wholesale: linux-firmware in full is several
# GB. These cover the wireless and GPU parts actually found in PCs of the last
# fifteen years or so.
################################################################################
BR2_PACKAGE_LINUX_FIRMWARE=y
# CPU microcode. Errata are a leading cause of the unreproducible hangs a
# foundation exists to rule out, and new silicon has the most of them.
# post-build.sh packs both vendors' blobs into /boot/microcode.img, which
# GRUB loads as an early initrd. Intel's is under its own licence, in the
# same class as the other firmware blobs here; every distribution ships it.
BR2_PACKAGE_INTEL_MICROCODE=y
BR2_PACKAGE_INTEL_MICROCODE_INSTALL_TARGET=y
BR2_PACKAGE_LINUX_FIRMWARE_AMD_UCODE=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y
BR2_PACKAGE_LINUX_FIRMWARE_RADEON=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_3160=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_3168=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7260=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7265D=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8000C=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22000=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_9271=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_10K_QCA998X=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_11K_WCN6855=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_81XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW89=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7925=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y

################################################################################
# M3 -- graphics.
#
# DRM/KMS + Mesa (GBM/EGL/Vulkan) + libglvnd. No X server, no Wayland
# compositor, no display manager: a user writes a compositor straight against
# DRM/KMS + GBM + EGL. libwayland and the protocol XML are here so that
# writing one does not start with adding packages.
#
# libglvnd is not optional. Mesa hands GL/EGL dispatch to it, and it is what
# lets the Mesa drivers and the NVIDIA blob coexist and be selected per
# device -- exactly what a hybrid Intel + NVIDIA laptop needs.
#
# Note there is no OPENGL_GL symbol: Buildroot offers OPENGL_GLX, which needs
# X11. Desktop GL is reached through EGL here.
################################################################################
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_LIBGLVND=y
BR2_PACKAGE_MESA3D=y
# Gates iris, radeonsi, llvmpipe and the Intel/AMD Vulkan drivers. Without
# it kconfig silently drops all of them and you get a Mesa with almost no
# hardware support. Pulls in LLVM, which dominates the build time.
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y

# Gallium (OpenGL). crocus covers Intel Gen4-7, iris Gen8+; r600 covers the
# older Radeons and radeonsi the GCN-and-later ones. llvmpipe is the software
# fallback that makes the image work on a GPU with no native driver at all.
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_CROCUS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R600=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_NOUVEAU=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_ZINK=y

# Vulkan. Buildroot's mesa3d exposes no nouveau/NVK driver, so NVIDIA Vulkan
# comes only from the proprietary blob in M4.
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_INTEL=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_AMD=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_VIRTIO=y

# The loader is what actually finds and dispatches to those ICDs.
BR2_PACKAGE_VULKAN_LOADER=y

BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y

################################################################################
# M4 -- self-hosting.
#
# post-build.sh exports the development sysroot (headers, crt files, static
# archives, the unversioned .so symlinks and the pkg-config metadata) from
# staging into the target. Without it the compiler below has nothing to
# compile against.
################################################################################
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_AOS_PATH)/board/aos/post-build.sh"

BR2_PACKAGE_AOS_GCC=y
BR2_PACKAGE_AOS_RUST=y

# NVIDIA. The kernel modules are Dual MIT/GPL; the userspace half is
# proprietary, which is why aos-nvidia is opt-in rather than implied by
# aos-nvidia-open. CUDA is left off -- it is large and a foundation image
# does not need it; flip BR2_PACKAGE_AOS_NVIDIA_CUDA if you do.
BR2_PACKAGE_AOS_NVIDIA=y
BR2_PACKAGE_AOS_NVIDIA_SMI=y

################################################################################
# M5 -- hybrid BIOS + UEFI live ISO.
#
# The root filesystem IS the ISO, mounted read-only, rather than an initrd
# unpacked into RAM. With Mesa, the Rust toolchain and the development
# sysroot on board the image is a couple of gigabytes, and an initrd that
# size would need as much RAM again -- which defeats supporting older
# machines. zisofs stores files compressed and expands them on read, so the
# kernel needs CONFIG_ZISOFS (set in linux.config.fragment).
#
# /var is a tmpfs seeded from a factory copy -- see the System section.
################################################################################
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_GRUB2=y
# BR2_TARGET_ROOTFS_ISO9660_INITRD is not set
BR2_TARGET_ROOTFS_ISO9660_TRANSPARENT_COMPRESSION=y
BR2_TARGET_ROOTFS_ISO9660_BOOT_MENU="$(BR2_EXTERNAL_AOS_PATH)/board/aos/iso-grub.cfg"

BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
# 'cd' and the iso9660 module are what let the BIOS GRUB core find its
# configuration on the optical medium rather than on a disk partition.
BR2_TARGET_GRUB2_BOOT_PARTITION="cd"
BR2_TARGET_GRUB2_BUILTIN_MODULES_PC="boot linux ext2 fat squash4 part_msdos part_gpt normal biosdisk iso9660 serial terminal search search_fs_file test regexp echo"
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat squash4 part_msdos part_gpt normal efi_gop iso9660 serial terminal search search_fs_file test regexp echo"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_EFI="$(BR2_EXTERNAL_AOS_PATH)/board/aos/grub-embedded.cfg"
BR2_TARGET_GRUB2_BUILTIN_CONFIG_PC="$(BR2_EXTERNAL_AOS_PATH)/board/aos/grub-embedded.cfg"
# aos-install runs grub-install and grub-mkconfig on the installed system.
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
# NOTE: there is deliberately no POST_IMAGE script here.
#
# An earlier attempt made the ISO USB-bootable by re-running xorriso over the
# staging tree from a post-image script. That is wrong: Buildroot generates
# filesystem images inside a fakeroot session so that everything is owned by
# root, and post-image scripts run outside it. The rebuilt ISO came out owned
# by the build user, which left the booted system unable to open /dev/console
# or write to /run, so the network and getty both failed.
#
# Making the ISO hybrid has to preserve that ownership -- see the note on USB
# booting in PLATFORM.md.
