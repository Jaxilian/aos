config BR2_PACKAGE_NOTEPAD
	bool "notepad (text editor)"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_HOST_RUSTC
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_VULKAN_LOADER
	select BR2_PACKAGE_WAYLAND
	help
	  A text editor: the first AOS application that is not part of
	  the desktop itself. Built on awin (Wayland + Vulkan) and tgn
	  (the widget layer on top of it), so it is also what proves
	  that stack works on the image.

	  Run it as "notepad [file]" from a terminal in the session, or
	  put it in ADE_AUTOSTART.

	  It draws with Vulkan, which means the loader here is not
	  enough on its own -- the loader finds nothing unless an ICD is
	  also installed. There is no single symbol to depend on for
	  that, so it is not expressed here; the AOS defconfig turns on
	  the Intel, AMD, virtio and swrast Mesa drivers, and the last
	  of those is what makes this work on a machine with no Vulkan
	  hardware at all.

	  Fonts are not a runtime dependency: tgn compiles one in with
	  include_bytes!, and the keymap comes from the compositor over
	  the wl_keyboard fd, so xkeyboard-config is not needed either.

comment "notepad needs a toolchain w/ threads and dynamic libs"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on !BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS

if BR2_PACKAGE_NOTEPAD

config BR2_PACKAGE_NOTEPAD_PATH
	string "notepad source tree"
	default "$(BR2_EXTERNAL_AOS_PATH)/../../../Rust/notepad"
	help
	  Absolute path to the notepad checkout to build from. The
	  default is where it lives on a development machine, beside
	  the crates it depends on.

	  A local path rather than a download, for the same reason as
	  ade: the application is co-developed with the OS and a build
	  tracks the working tree, uncommitted state included.

	  Note that this path covers notepad itself and nothing else.
	  Its awin and tgn dependencies are absolute paths written into
	  notepad's own Cargo.toml, so they are read straight from the
	  developer's tree wherever that points -- not from here, and
	  not from the build directory. Two consequences: moving those
	  crates breaks the build until Cargo.toml is updated, and
	  editing them does not make Buildroot rebuild anything. Use
	  "make notepad-rebuild" after changing awin or tgn.

endif
