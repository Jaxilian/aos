config BR2_PACKAGE_AOS_STORE
	bool "aos-store (the app store)"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_HOST_RUSTC
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_VULKAN_LOADER
	select BR2_PACKAGE_WAYLAND
	help
	  "Software": a graphical front to apm. Installed, Official and
	  Third-party pages with search, Install and Remove, the key the
	  index is signed with, and Updates with one button that takes
	  every package and a new AOS. Reads through apm-core as the
	  user; changes go through sudo apm, with the password asked for
	  once, like the Settings application.

comment "aos-store needs a toolchain w/ threads and dynamic libs"
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on !BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS
