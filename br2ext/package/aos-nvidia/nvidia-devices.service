# The NVIDIA device nodes, made by nvidia-nodes (beside this file): what
# nvidia-modprobe makes, and what it leaves out. Wanted by multi-user,
# after the modules have loaded, and only where a GPU is bound to nvidia:
# on any other machine the condition fails and nothing runs.
# 60-nvidia.rules asks for it from udev as well, for a GPU that appears
# later.
[Unit]
Description=NVIDIA device nodes
ConditionPathExistsGlob=/sys/bus/pci/drivers/nvidia/0000:*
After=systemd-modules-load.service
Before=graphical.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nvidia-nodes

[Install]
WantedBy=multi-user.target
