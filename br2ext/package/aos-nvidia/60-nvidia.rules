# The NVIDIA userspace talks to /dev/nvidiactl, /dev/nvidia0, /dev/nvidia-uvm
# and /dev/nvidia-modeset, which the kernel modules never create: on other
# distributions the X driver or a setuid nvidia-modprobe makes them on first
# use. Here udev asks systemd for nvidia-devices.service once the GPU is
# bound to nvidia. A service rather than RUN+=: RUN's output and failures
# never reach the journal, and on the G14 the nodes were simply not there
# with nothing to say why.
ACTION=="add|bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", ATTR{class}=="0x03[0-9]*", \
	DRIVER=="nvidia", TAG+="systemd", ENV{SYSTEMD_WANTS}+="nvidia-devices.service"
