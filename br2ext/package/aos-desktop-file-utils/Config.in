config BR2_PACKAGE_AOS_DESKTOP_FILE_UTILS
	bool "desktop-file-utils (for the target)"
	depends on BR2_USE_WCHAR # libglib2
	depends on BR2_TOOLCHAIN_HAS_THREADS # libglib2
	depends on BR2_USE_MMU # libglib2
	select BR2_PACKAGE_LIBGLIB2
	help
	  update-desktop-database and desktop-file-validate on the
	  machine. Buildroot builds desktop-file-utils for the host
	  only; third-party programs expect the tools where they run --
	  Firefox runs update-desktop-database when it is made the
	  default browser, and reports an error when it is not there.

	  https://www.freedesktop.org/wiki/Software/desktop-file-utils/
